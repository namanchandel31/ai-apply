# Environment variables
DB_PASSWORD=
DATABASE_URL=
OPENAI_API_KEY=
JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SMTP Debug
SMTP_DEBUG=false

# Queue & Worker (Auto-Apply)
REDIS_URL=redis://localhost:6379
INTERNAL_API_KEY=your_secure_internal_key
# inline = start BullMQ workers inside `npm run dev` (dev only, both process-application + send-application)
# separate = run `npm run worker` in a second terminal (required for production)
WORKER_MODE=inline
WORKER_CONCURRENCY=3
PROCESS_WORKER_CONCURRENCY=2
# Realtime SSE fan-out via Redis (set REALTIME_REDIS=0 to use in-process bus only)
REALTIME_REDIS_CHANNEL=ai-apply:realtime
MAX_PROCESSING_ATTEMPTS=5
AUTO_APPLY_HOURLY_LIMIT=10
AUTO_APPLY_DAILY_LIMIT=50
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
REDIS_URL=

# Logging
LOG_LEVEL=info
LOG_DEDUPE_WINDOW_MS=60000
LOG_DEDUPE_BUCKET_TTL_MS=120000
LOG_DEDUPE_MAX_BUCKETS=500

# Backend orchestration debug (1/true to enable)
DEBUG_ORCHESTRATION_REALTIME=0
DEBUG_ORCHESTRATION_RECONCILIATION=0
DEBUG_ORCHESTRATION_HYDRATION=0
DEBUG_ORCHESTRATION_TRANSPORT=0
DEBUG_ORCHESTRATION_LEADER=0
DEBUG_ORCHESTRATION_POLL=0

# Debugging
DEBUG_RESUME_EXTRACTION_ONLY=false
# Log QUERY_EXEC (name, params, sql hash) for every instrumented / wrapped pool query
DEBUG_QUERY_SHAPE=1

# Frontend orchestration debug (Vite; 1/true to enable)
VITE_DEBUG_ORCHESTRATION_REALTIME=0
VITE_DEBUG_ORCHESTRATION_RECONCILIATION=0
VITE_DEBUG_ORCHESTRATION_HYDRATION=0
VITE_DEBUG_ORCHESTRATION_TRANSPORT=0
VITE_DEBUG_ORCHESTRATION_LEADER=0
VITE_DEBUG_ORCHESTRATION_POLL=0

# LLM Operational Hardening
LLM_GLOBAL_RETRY_BUDGET=100
LLM_RETRY_WINDOW_MS=60000
LLM_CIRCUIT_BREAKER_THRESHOLD=10
LLM_CIRCUIT_BREAKER_COOLDOWN_MS=30000