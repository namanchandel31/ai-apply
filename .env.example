# =========================================
# SERVER
# =========================================
NODE_ENV=development
PORT=5000

# Worker deployment: combined (Render prod) | separate (split API + worker) | inline (dev legacy)
WORKER_MODE=combined
# Diagnostic only (bootstrap.js): set false to skip BullMQ workers while API stays up
# ENABLE_WORKERS=false

# =========================================
# DATABASE
# =========================================
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_apply

# =========================================
# REDIS (BullMQ queues + realtime fan-out)
# =========================================
# Local:
# Use 127.0.0.1 on Windows + Docker if localhost causes ECONNRESET (auto-normalized in app)
REDIS_URL=redis://127.0.0.1:6379
# Upstash (use the TCP/rediss URL from the Upstash dashboard):
# UPSTASH_REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379
# UPSTASH_REDIS_TOKEN=

# =========================================
# SUPABASE (backend JWT verify — must match frontend VITE_SUPABASE_URL project)
# =========================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional JWT overrides (defaults: issuer = SUPABASE_URL/auth/v1, audience = authenticated)
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_AUDIENCE=authenticated
# AUTH_DEBUG=1

# =========================================
# CORS (comma-separated Vercel origins for production)
# =========================================
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-*.vercel.app

# =========================================
# AUTH / INTERNAL
# =========================================
INTERNAL_API_KEY=

# =========================================
# ENCRYPTION (32-byte hex — see README)
# =========================================
ENCRYPTION_KEY=

# =========================================
# AI
# =========================================
OPENAI_API_KEY=

# Model certification pipeline tuning (admin access gated by users.is_admin)
# MODEL_CERT_VALUE_NORM_DIVISOR=30000

# =========================================
# OBSERVABILITY (optional)
# =========================================
# SENTRY_DSN=

# =========================================
# LOGGING & DEBUG
# =========================================
LOG_LEVEL=info
LOG_PRETTY=true
# Comma-separated: orchestration | query | llm
DEBUG=

# =========================================
# PRODUCT LIMITS
# =========================================
AUTO_APPLY_HOURLY_LIMIT=10
AUTO_APPLY_DAILY_LIMIT=50
# Set to false to bypass subscription paywall (API treats all users as subscribed)
# PRICING_ENABLED=false

# =========================================
# FRONTEND (Vercel — client/.env)
# =========================================
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_URL=https://your-api.onrender.com

# =========================================
# RAZORPAY
# =========================================
RAZORPAY_KEY_ID=rzp_test_T3pIZGoXZu1aZU
RAZORPAY_KEY_SECRET=4yNbeZfnAvS8sCURk4eFNZTQ
RAZORPAY_WEBHOOK_SECRET=zfWm4o22aAaJG9rN7qE9eFqQ
RAZORPAY_CURRENCY=INR

# =========================================
# BILLING
# =========================================
BILLING_PLAN_BYOK_PAISE=9900
BILLING_PLAN_ONETAP_LLM_PAISE=14900