# Supabase (Google OAuth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production API origin (e.g. https://api.your-domain.com). Leave empty for local dev
# (relative /api paths + Vite proxy to the backend).
VITE_API_URL=

# Chrome extension ID from chrome://extensions (dev unpacked load)
VITE_ONETAP_EXTENSION_ID=mgomnfadfjolgedokakfkoloolfekifm

# Set to false to skip in-app pricing/paywall (sign up → onboarding → dashboard)
# VITE_PRICING_ENABLED=false

# VITE_DEBUG_AUTH=1
