{
  "manifest_version": 3,
  "name": "OneTap",
  "version": "0.1.7",
  "description": "Discover LinkedIn hiring posts and add them to OneTap.",
  "permissions": ["storage", "activeTab", "alarms", "tabs", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "http://localhost:5000/*",
    "https://ybfzpfouqmdacgfxieec.supabase.co/*",
    "https://ai-apply-jwan.onrender.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OneTap",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["src/content/linkedin/main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/popup.html",
        "src/popup/popup-embedded.js",
        "src/popup/popup.js",
        "src/popup/popup.css",
        "src/content/linkedin/main.js",
        "src/config/app.config.js",
        "src/shared/applyModeCopy.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://onetapjob.com/*"
    ]
  }
}
